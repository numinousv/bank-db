DATABASE_URL=postgres://bankuser:your-password@<DB-EC2-PRIVATE-IP>:5432/bank
# JWT signing key: generate with `openssl rand -hex 32`. Must be at least
# 32 bytes or the server refuses to start. Never commit the real value.
JWT_SECRET=paste-output-of-openssl-rand-hex-32-here
# Exact browser origin(s) allowed to call the API with cookies (comma-separated).
FRONTEND_ORIGIN=http://<PUBLIC-IPv4/DOMAIN>
# Set to true only when the site runs over HTTPS; browsers reject
# Secure cookies on plain HTTP.
COOKIE_SECURE=false
