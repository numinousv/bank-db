# copy to .env and fill in the actual values. .env is ignored by git.
# never commit passwords to git. set 600 permissions on the server: chmod 600 .env
#
#   cp .env.example .env

# postgresql (db-container). user owns the database, so no
# extra GRANT required, this avoids permission errors from
# manual installation
# otherwise run: sudo usermod -aG docker $USER
# then run: sudo systemctl enable --now docker.socket
# and then: sudo systemctl start docker.socket
# check with ' groups $USER ', if docker is listed, no need for sudo usage when using docker.
POSTGRES_USER=bankuser
POSTGRES_PASSWORD=choose-a-strong-password
POSTGRES_DB=bank

# backend's public URL
# change <http://PUBLIC-IPv4/DOMAIN> to your own domain/ec2 IPv4 address.
NEXT_PUBLIC_API_URL=http://<PUBLIC-IPv4/DOMAIN>:3001

# VG feature flag (deployment vs release). false = the new dashboard code
# ships in the image but stays hidden; true = it is released to users.
# takes effect at frontend build time (docker compose up -d --build).
NEXT_PUBLIC_FEATURE_NEW_DASHBOARD=false

# JWT signing key for the api container (generate with `openssl rand -hex 32`).
# Must be at least 32 bytes. Each environment gets its own value; the test
# stack and CI use a separate test-only key, never this one.
JWT_SECRET=paste-output-of-openssl-rand-hex-32-here
# Exact browser origin allowed to call the API with cookies.
FRONTEND_ORIGIN=http://<PUBLIC-IPv4/DOMAIN>
# Keep false on plain HTTP; browsers reject Secure cookies without HTTPS.
COOKIE_SECURE=false
